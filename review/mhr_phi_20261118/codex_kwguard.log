QWEN_PATHS = {
    'review/mhr_st_20261112': 'ST',
    'review/mhr_f_20261114': 'F',
    'review/mhr_ce_20261116': 'CE',
    'review/mhr_set_20261117': 'SET',
    'MultiHop-RAG-qwen-full609': 'INDEX',
}
QWEN_ROOTS = tuple(ROOT / path for path in QWEN_PATHS)
SHARED_SOURCE = QWEN_ROOTS[0] / 'source'
SHARED_INPUTS = QWEN_ROOTS[0] / 'inputs'
EMBEDDING_RECEIPT = QWEN_ROOTS[0] / 'embedding_cache.json'

_dotenv_read = ContextVar('phi_dotenv_read', default=None)
_installed = False
_network_denied = False
_NETWORK_EVENTS = {'socket.connect', 'socket.connect_ex', 'socket.bind', 'socket.getaddrinfo',
                   'socket.getnameinfo', 'socket.gethostbyname', 'socket.gethostbyaddr',
                   'socket.sendto', 'socket.sendmsg', 'http.client.connect'}


def is_ladder(name):
    return any(name == package or name.startswith(package + '.') for package in PACKAGES)


def _path(value):
    if isinstance(value, (str, bytes, os.PathLike)):
        return Path(os.fsdecode(value))
    return None


def _protect(path):
    if path is None:
        return
    literal = Path(os.path.abspath(path))
    resolved = path.resolve()
    if any(candidate.is_relative_to(root) for candidate in (literal, resolved) for root in QWEN_ROOTS):
        raise PermissionError(f'Qwen artifact is read-only under the Phi profile: {path}')


def _audit(event, args):
    if _network_denied and event in _NETWORK_EVENTS:
        # CPython on Windows builds asyncio's internal wakeup pipe with a
        # loopback socket pair. Only that standard-library call may connect.
        frame = sys._getframe(1)
        internal_pipe = (event in ('socket.bind', 'socket.connect')
                         and frame.f_globals.get('__name__') == 'socket'
                         and frame.f_code.co_name == '_fallback_socketpair'
                         and args[1][0] in ('127.0.0.1', '::1'))
        if not internal_pipe:
            raise PermissionError(f'Network is disabled for offline Phi work: {event}')
    if event == 'open':
        path = _path(args[0])
        if path is None:
            return
        mode, flags = args[1:]
        mutation_flags = (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
                          | getattr(os, 'O_TEMPORARY', 0))
        writing = bool((mode and any(flag in mode for flag in 'wax+')) or flags & mutation_flags)
        allowed = _dotenv_read.get()
        names = (path.name.lower(), path.resolve().name.lower()) if not writing else (path.name.lower(),)
        if any(name == '.env' or name.startswith('.env.') for name in names) or (
            allowed is not None and path.resolve() == allowed
        ):
            if writing or allowed is None or path.resolve() != allowed:
                raise PermissionError('Only the Phi launcher may read its explicitly selected dotenv file')
        if writing:
            _protect(path)
    elif event in ('os.rename', 'os.link', 'os.symlink'):
        for value in args[:2]:
            _protect(_path(value))
    elif event in ('os.mkdir', 'os.remove', 'os.rmdir', 'os.chmod', 'os.chown',
                   'os.utime', 'os.truncate', 'os.chflags', 'shutil.rmtree'):
        _protect(_path(args[0]))


@contextmanager
def _launcher_dotenv(path):
    allowed = Path(path).resolve(strict=True)
    token = _dotenv_read.set(allowed)
    try:
        yield allowed
    finally:
        _dotenv_read.reset(token)


def no_dotenv(*args, **kwargs):
    return False


# These are the function-local exceptions found in the AST scan. Ordinary
# imported aliases and derived constants evaluate normally after the rewrite.
_FUNCTIONS = {
    'mhr_st.common': {'setup': 'return _phi_runtime.setup(source)'},
    'mhr_st.run': {'prepare': 'return _phi_runtime.prepare_st()',
                   'preflight': 'return _phi_runtime.preflight_st()'},
    'mhr_st.finish': {'amendment': 'return None'},
    'mhr_ce.offline': {'setup': ('from reproduce.mhr_f import study\n'
                                 'study.setup = setup\n'
                                 'return _phi_runtime.setup(source)')},
}
_PATH_EXPRESSIONS = {
    "OUT / 'archive_c0'": 'ARCHIVE',
    "ROOT / 'runs/multihop_rag/dev400/C0_s101'": 'DEV_C0',
    "ROOT.parent / 'MiniRAG/runs/multihop_rag/dev400/C0_s101/context.jsonl'": 'DEV_C0 / "context.jsonl"',
    "OUT / 'source'": 'SHARED_SOURCE',
    "ST_OUT / 'source'": 'SHARED_SOURCE',
    "ST_OUT / 'embedding_cache.json'": 'EMBEDDING_RECEIPT',
    "OUT / 'embedding_cache.json'": 'EMBEDDING_RECEIPT',
}


class _PhiSource(ast.NodeTransformer):
    def __init__(self, module):
        self.module = module.removeprefix('reproduce.')

    def visit_FunctionDef(self, node):
        replacement = _FUNCTIONS.get(self.module, {}).get(node.name)
        if replacement:
            node.body = ast.parse(replacement).body
            return node
        if self.module == 'mhr_st.pipeline' and node.name == 'execute':
            # The original execute judges all ST answers before finish can apply
            # the registered identical-answer reuse. Let finish do the judging.
            block = node.body[0]
            first = next(i for i, statement in enumerate(block.body)
                         if isinstance(statement, ast.For)
                         and "judge('test', seed)" in ast.unparse(statement))
            block.body[first:-1] = ast.parse(
                "write(OUT / 'status.json', {'state': 'contexts_and_answers_done'})").body
        return self.generic_visit(node)

    def visit_BinOp(self, node):
        if not isinstance(node.op, ast.Div):
            return self.generic_visit(node)
        replacement = _PATH_EXPRESSIONS.get(ast.unparse(node))
        if replacement:
            return ast.copy_location(ast.parse('_phi.' + replacement, mode='eval').body, node)
        if isinstance(node.right, ast.Constant) and isinstance(node.right.value, str):
            path = node.right.value
            if path == 'source/reproduce/research/serving_qwen_modal.json':
                return ast.copy_location(ast.parse('_phi.SERVING', mode='eval').body, node)
            if path.startswith('source/'):
                return ast.copy_location(ast.parse(
                    f'_phi.SHARED_SOURCE / {path.removeprefix("source/")!r}', mode='eval').body, node)
        if (isinstance(node.right, ast.JoinedStr)
                and isinstance(node.right.values[0], ast.Constant)
                and node.right.values[0].value.startswith('archive_c0/')):
            node.left = ast.parse('_phi.ARCHIVE', mode='eval').body
            node.right.values[0].value = node.right.values[0].value.removeprefix('archive_c0/')
        return self.generic_visit(node)

    def visit_Constant(self, node):
        if not isinstance(node.value, str):
            return node
        # The scores module constructs its review path from two segments.
        if self.module == 'mhr_ce.scores' and node.value == 'mhr_ce_20261116':
            node.value = 'mhr_phi_20261118/ce'
        elif node.value in QWEN_PATHS:
            node.value = str(globals()[QWEN_PATHS[node.value]].relative_to(ROOT))
        elif 'Qwen2.5-3B | Judge:' in node.value:
            node.value = node.value.replace('Qwen2.5-3B', TITLE)
        elif node.value == 'SET vs F is secondary because CE was not confirmed over F.':
            node.value = 'SET vs F is a registered secondary comparison.'
        elif self.module == 'mhr_st.run' and 'MultiHop-RAG/Qwen benchmark' in node.value:
            node.value = node.value.replace('MultiHop-RAG/Qwen benchmark', 'MultiHop-RAG/Phi benchmark')
        elif self.module == 'mhr_f.pool' and 'review/mhr_st_20261112/source' in node.value:
            node.value = node.value.replace('review/mhr_st_20261112/source', 'shared frozen source')
            node.value = node.value.replace('MiniRAG dev400 C0_s101', 'Phi dev400 C0_s101')
        elif self.module == 'mhr_ce.scores' and 'review/mhr_ce_20261116/' in node.value:
            node.value = node.value.replace('review/mhr_ce_20261116/', 'review/mhr_phi_20261118/ce/')
        elif self.module == 'mhr_ce.modal_ce' and 'review/mhr_ce_20261116/PROTOCOL.md' in node.value:
            node.value = node.value.replace('review/mhr_ce_20261116/PROTOCOL.md', 'review/mhr_phi_20261118/PROTOCOL.md')
        return node


class _PhiLoader(SourceFileLoader):
    def get_code(self, fullname):
        filename = self.get_filename(fullname)
        tree = _PhiSource(fullname).visit(ast.parse(self.get_data(filename), filename))
        # Preserve the docstring and future imports, for both ordinary imports
        # and runpy's independent __main__ namespace.
        first = int(bool(ast.get_docstring(tree, clean=False)))
        while (first < len(tree.body) and isinstance(tree.body[first], ast.ImportFrom)
               and tree.body[first].module == '__future__'):
            first += 1
        tree.body[first:first] = ast.parse(
            'from reproduce.mhr_phi import profile as _phi, runtime as _phi_runtime').body
        return compile(ast.fix_missing_locations(tree), filename, 'exec')


class _PhiFinder:
    def find_spec(self, fullname, path=None, target=None):
        if not is_ladder(fullname):
            return None
        spec = PathFinder.find_spec(fullname, path)
        if spec is not None and isinstance(spec.loader, SourceFileLoader):
            spec.loader = _PhiLoader(fullname, spec.origin)
        return spec


def apply(*, offline=False):
    """Install the profile before ladder import, with optional socket denial."""
    global _installed, _network_denied
    _network_denied |= offline
    if _installed:
        return
    already_loaded = sorted(name for name in sys.modules if is_ladder(name))
    if already_loaded:
        raise RuntimeError(f'Apply the Phi profile before importing the ladder: {already_loaded}')
    sys.dont_write_bytecode = True
    sys.addaudithook(_audit)
    sys.meta_path.insert(0, _PhiFinder())
    import dotenv
    dotenv.load_dotenv = no_dotenv
    _installed = True

"""Run a ladder module as __main__ with the Phi profile and inherited credentials."""

import os
from pathlib import Path
import runpy
import subprocess
import sys

from . import profile

MODULE = 'reproduce.mhr_phi.launch'
C0_MODULE = 'reproduce.mhr_phi.c0'
SECONDARY_MODULE = 'reproduce.mhr_phi.secondary'
_INHERITED = '_MHR_PHI_LAUNCH_ENV'
_OFFLINE_ONLY = '_MHR_PHI_OFFLINE_ONLY'
_ONLINE = {
    C0_MODULE: {'keywords', 'answers', 'execute'},
    SECONDARY_MODULE: {'ce-drift'},
    'reproduce.mhr_st.run': {'preflight', 'answers', 'execute'},
    'reproduce.mhr_f.run': {'answers', 'execute', 'finish'},
    'reproduce.mhr_ce.run': {'answers', 'execute', 'finish'},
    'reproduce.mhr_set.run': {'answers', 'execute', 'finish'},
}
_ALWAYS_ONLINE = {
    'reproduce.mhr_st.judge', 'reproduce.mhr_st.finish', 'reproduce.mhr_ce.scores',
    'reproduce.mhr_ce.judge_entry', 'reproduce.mhr_set.judge_entry',
    'reproduce.mhr_ce.online', 'reproduce.mhr_set.online',
}


def _profiled(module):
    return isinstance(module, str) and (profile.is_ladder(module) or module in (C0_MODULE, SECONDARY_MODULE))


def rewrite_command(command):
    if (not isinstance(command, (list, tuple)) or not command
            or not isinstance(command[0], (str, os.PathLike))
            or Path(command[0]).resolve() != Path(sys.executable).resolve()):
        return command
    # Only inspect interpreter options. A script may have its own unrelated -m.
    arguments = list(command)
    index = 1
    while index < len(arguments):
        option = arguments[index]
        if not isinstance(option, str) or not option.startswith('-') or option in ('-', '--', '-c'):
            break
        if option == '-m':
            if index + 1 < len(arguments) and _profiled(arguments[index + 1]):
                return arguments[:index + 1] + [MODULE] + arguments[index + 1:]
            break
        index += 2 if option in ('-W', '-X') else 1
    return command


def install_subprocess_rewrite():
    """subprocess.run and check_output also go through subprocess.Popen."""
    original = subprocess.Popen
    if getattr(original, '_phi_launcher', False):
        return

    class ProfiledPopen(original):
        _phi_launcher = True

        def __init__(self, args, *positional, **kwargs):
            rewritten = rewrite_command(args)
            if rewritten is not args:
                env = kwargs.get('env')
                kwargs['env'] = dict(os.environ if env is None else env) | {_INHERITED: '1'}
                kwargs['env']['PYTHONDONTWRITEBYTECODE'] = '1'
                if profile._network_denied:
                    kwargs['env'][_OFFLINE_ONLY] = '1'
            super().__init__(rewritten, *positional, **kwargs)

    subprocess.Popen = ProfiledPopen


def _is_online(module, args):
    if any(arg in ('-h', '--help') for arg in args):
        return False
    return module in _ALWAYS_ONLINE or any(arg in _ONLINE.get(module, ()) for arg in args)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help'):
        print('usage: python -B -m reproduce.mhr_phi.launch <module> [args]')
        return 0
    module, *args = sys.argv[1:]
    if not _profiled(module):
        raise SystemExit(f'Unsupported Phi ladder module: {module}')
    if Path.cwd().resolve() != profile.ROOT:
        raise SystemExit(f'Run the Phi launcher from the repository root: {profile.ROOT}')

    online = _is_online(module, args)
    inherited = os.environ.pop(_INHERITED, None) == '1'
    if online and os.environ.pop(_OFFLINE_ONLY, None) == '1':
        raise SystemExit('An offline Phi command cannot launch an online stage')
    import dotenv
    load_dotenv = dotenv.load_dotenv
    profile.apply(offline=not online)
    if online and not inherited:
        dotenv_path = os.environ.get('MINIRAG_DOTENV')
        if not dotenv_path:
            raise SystemExit('Set MINIRAG_DOTENV to the credential file before running online commands')
        with profile._launcher_dotenv(dotenv_path) as path:
            load_dotenv(path, override=False)
    url = os.environ.get('PHI_SLM_URL', '').strip()
    if online and not url:
        raise SystemExit('Set PHI_SLM_URL to the Phi LongRoPE serving endpoint')
    if url:
        os.environ['MINIRAG_SLM_URL'] = url
    if 'PYTHONUTF8' not in os.environ:
        os.environ['PYTHONUTF8'] = '1'
    os.environ['PYTHONDONTWRITEBYTECODE'] = '1'
    install_subprocess_rewrite()
    sys.argv = [module, *args]
    runpy.run_module(module, run_name='__main__', alter_sys=True)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

"""Shared frozen-source setup, index checks, and Phi serving validation."""

import argparse
import asyncio
import csv
from datetime import datetime, timezone
import hashlib
import importlib
import json
import os
from pathlib import Path
import sys
from unittest.mock import patch

from . import profile as p

SEEDS = (101, 202, 303)
JUDGE = 'gemini-3.5-flash-lite'
QUESTION_HASHES = {
    'dev': '4633ef777b747ef0fb8cca86457454eed64680432d899a3d5410afce2b63ef77',
    'test': 'e37a4599e8485b5b76f6b60157648b60564f51ee7eceaeb6798f7dbd523d069d',
}
QUESTIONS_N = {'dev': 400, 'test': 2156}
SOURCE_COMMIT = 'b640765fb6ac46a817d3d221e2d652240f9e0c6c'
DOCS_SHA = '5816d2d43cb0bbd825f61414c1648c38e57b495c211b7d046936da0c32fd8077'
RETRIEVAL_OVERRIDES = ('MINIRAG_PATH_PRUNE', 'MINIRAG_PATH_SCORE', 'MINIRAG_RERANK',
                       'MINIRAG_MAX_TOKEN_TEXT_UNIT')
_phased = None


def read(path):
    return json.loads(path.read_text(encoding='utf-8'))


def sha(path):
    with path.open('rb') as handle:
        return hashlib.file_digest(handle, 'sha256').hexdigest()


def now():
    return datetime.now(timezone.utc).isoformat()


def questions(split):
    path = p.ST / 'inputs' / f'{split}.csv'
    if sha(path) != QUESTION_HASHES[split]:
        raise RuntimeError(f'Frozen {split} question copy changed')
    with path.open(encoding='utf-8-sig', newline='') as handle:
        rows = list(csv.DictReader(handle))
    if len(rows) != QUESTIONS_N[split] or len({r['query_id'] for r in rows}) != len(rows):
        raise RuntimeError(f'Frozen {split} question count or IDs changed')
    return rows


def source_checks():
    expected = read(p.OUT / 'frozen_source_sha256.json')
    checks = {name: sha(p.SHARED_SOURCE / name) == digest for name, digest in expected.items()}
    if not all(checks.values()):
        raise RuntimeError(f'Frozen source changed: {[name for name, ok in checks.items() if not ok]}')
    return checks


def hf_cache():
    local = p.ROOT / 'data/leef/cache/huggingface/hub'
    return local if local.is_dir() else p.ROOT.parent / 'MiniRAG/data/leef/cache/huggingface/hub'


def setup(source=None):
    """Use the existing immutable snapshot and the local embedding cache."""
    global _phased
    source = Path(source or p.SHARED_SOURCE).resolve()
    if source != p.SHARED_SOURCE.resolve():
        raise ValueError('Phi ladder requires the frozen MiniRAG source')
    for path in (source, source / 'reproduce', source / 'reproduce/research'):
        if str(path) not in sys.path:
            sys.path.insert(0, str(path))
    os.environ.update(PYTHONUTF8='1', PYTHONDONTWRITEBYTECODE='1', HF_HUB_OFFLINE='1',
                      TRANSFORMERS_OFFLINE='1', HF_DATASETS_OFFLINE='1',
                      HF_HUB_DISABLE_TELEMETRY='1', TOP_K='60',
                      HF_HUB_CACHE=str(hf_cache()), TIKTOKEN_CACHE_DIR=str(p.ROOT / 'data-gym-cache'))
    if _phased is None:
        phased = importlib.import_module('phased_qa')
        if Path(phased.__file__).resolve() != source / 'reproduce/research/phased_qa.py':
            raise RuntimeError('Loaded phased_qa from outside the frozen source')
        phased.INDEX = p.INDEX
        phased.snapshot.__defaults__ = (p.INDEX,)
        phased.use_slm = configure_slm
        phased.traced = traced
        original_build = phased.build

        def build(workdir, llm_max_async=32):
            if os.environ.get('MINIRAG_KW_CACHE_ONLY') != '1':
                return original_build(workdir, llm_max_async=llm_max_async)
            # The Phase 3 offline worker used the same construction bypass.
            # The LLM is replaced immediately, before any retrieval can run.
            with patch('gemini_common._resolve_api_keys', return_value=[]):
                rag = original_build(workdir, llm_max_async=llm_max_async)
            rag.llm_model_func = phased._forbidden_llm
            return rag

        phased.build = build
        _phased = phased
    return source


def phased_runner():
    setup()
    return _phased


def configure_slm():
    phased_runner().qa_run.configure_environment(argparse.Namespace(backend='modal'))
    os.environ['MINIRAG_MAX_TOKENS'] = '1024'


def serving_spec():
    spec = read(p.SERVING)
    if spec['model'] != p.MODEL or spec['vllm_version'] != '0.11.0':
        raise RuntimeError('Serving spec differs from the registered Phi model or vLLM version')
    return spec


def check_serving():
    import httpx

    spec = serving_spec()
    configure_slm()
    endpoint = os.environ['MINIRAG_SLM_URL'].rstrip('/').removesuffix('/v1')
    headers = {'Authorization': 'Bearer ' + os.environ['MINIRAG_SLM_KEY']}
    observed = {}
    for field, route in (('version', '/version'), ('models', '/v1/models')):
        for attempt in range(4):
            try:
                response = httpx.get(endpoint + route, headers=headers, timeout=60)
                response.raise_for_status()
                observed[field] = response.json()
                break
            except httpx.TimeoutException:
                if attempt == 3:
                    raise RuntimeError(f'Phi serving {field} check timed out during cold start') from None
    models = {item['id']: item for item in observed['models'].get('data', [])}
    if not {'minirag-slm', spec['model']} <= models.keys():
        raise RuntimeError('The SLM endpoint does not serve both registered Phi model names')
    if observed['version'].get('version') != spec['vllm_version']:
        raise RuntimeError('The SLM endpoint changed vLLM version')
    revision = models[spec['model']].get('model_revision')
    if revision is not None and revision != spec['model_revision']:
        raise RuntimeError('The SLM endpoint changed Phi model revision')
    return {'at': now(), 'model': spec['model'], 'served_models': sorted(models),
            'vllm_version': observed['version']['version'], 'registered_model_revision': spec['model_revision'],
            'observed_model_revision': revision}


def require_phi_response(record):
    if record.get('ok') and record.get('response_model') != p.MODEL:
        raise RuntimeError(f'SLM response did not identify the registered Phi model: {record.get("response_model")!r}')


def traced(directory, action):
    """Keep a request journal for the frozen runner and reject non-Phi replies."""
    import llm_trace

    llm_trace.install()
    with (Path(directory) / 'requests.jsonl').open('a', encoding='utf-8', newline='\n') as handle:
        def sink(record):
            record.pop('response_text', None)
            _phased.append_jsonl(handle, record | {'at': now()})
            require_phi_response(record)

        with llm_trace.trace(sink):
            return asyncio.run(action())


def verify_index(index, *, pilot=False):
    from reproduce.index_health import health

    manifest = read(index / 'index_manifest.json')
    kind, count = ('pilot', 30) if pilot else ('full', 609)
    if (manifest.get('status') != 'completed' or manifest.get('subset') != kind
            or manifest.get('counts', {}).get('docs') != count
            or manifest.get('docs_jsonl_sha256') != DOCS_SHA):
        raise RuntimeError(f'Expected a completed {count}-article Phi {kind} index')
    settings = {'chunk_token_size': 1200, 'chunk_overlap_token_size': 100,
                'tiktoken_model_name': 'gpt-4o-mini', 'entity_extract_max_gleaning': 1,
                'model': 'minirag-slm', 'embedmodel': 'local', 'max_tokens': '4096'}
    if pilot:
        settings.update(pilot_seed=13, pilot_size=30)
    if any(manifest['settings'].get(key) != value for key, value in settings.items()):
        raise RuntimeError('Index settings differ from the registered settings')
    verified = manifest.get('verification')
    files = manifest.get('file_sha256')
    if not verified or not all(value is True for value in verified.values()) or not files:
        raise RuntimeError('Index verification is incomplete')
    checks = {name: sha(index / name) == digest for name, digest in files.items()}
    if not all(checks.values()):
        raise RuntimeError(f'Index files changed: {[name for name, ok in checks.items() if not ok]}')
    coverage = health(index)
    if not coverage['chunks'] or coverage['zero_entity_chunks'] / coverage['chunks'] > .05:
        raise RuntimeError('Index gate I failed: more than 5% of chunks have zero entities')
    return checks, coverage


def prepare_st():
    from reproduce.mhr_f.pool import check_embedding
    from reproduce.mhr_st.common import write

    source = source_checks()
    checks, coverage = verify_index(p.INDEX)
    check_embedding()
    from .c0 import require_completed
    for split, seed in (('dev', 101), *(('test', seed) for seed in SEEDS)):
        require_completed(split, seed)
    receipt = {'experiment': 'MultiHop-RAG Phi C0 + source-time only', 'date': '2026-11-18',
               'source_commit': SOURCE_COMMIT, 'source_checks': source, 'slide_temporal_commit': '1297b2e',
               'slide_temporal_sha256': sha(p.SHARED_SOURCE / 'temporal_slide.py'),
               'index': str(p.INDEX), 'index_manifest_sha256': sha(p.INDEX / 'index_manifest.json'),
               'index_checks': checks, 'index_health': coverage, 'model': p.MODEL,
               'serving_config_sha256': sha(p.SERVING), 'question_sha256': QUESTION_HASHES,
               'seeds': list(SEEDS), 'judge_model': JUDGE, 'judge_passes': 3,
               'budget_tokens': 4000, 'top_k': 60, 'max_answer_tokens': 1024,
               'st': {'metadata': 'published_at -> every chunk of its document',
                      'anchors': 'unchanged slide day/month parser', 'per_anchor_limit': 3,
                      'expand': True, 'entity_h': True, 'fallback': 'native C0 when no anchor'},
               'controls': 'Phi C0 index, keyword caches, embedding, graph scoring, Entities, prompt and A1 are frozen.',
               'c0_answers': 'Use same-seed Phi C0 answers and share verdicts for identical ST answers.',
               'dev': 400, 'test': 2156,
               'statistics': 'Paired exact McNemar per generation seed. Report ACC, ERR, Neither and no majority.'}
    # JSON loads the health buckets as lists. Compare the persisted representation.
    receipt = json.loads(json.dumps(receipt, ensure_ascii=False))
    dest = p.ST / 'protocol.json'
    if dest.exists():
        if read(dest) != receipt:
            raise RuntimeError('Phi ST protocol or its inputs changed')
    else:
        write(dest, receipt)
    print(json.dumps({'prepared': True, 'source_files_verified': len(source),
                      'index_files_verified': len(checks), 'run': str(p.ST)}), flush=True)


def preflight_st():
    import httpx
    from reproduce.mhr_st.common import write

    result = {'at': now(), 'judge_model': JUDGE, 'slm': check_serving(), 'gemini': []}
    keys = [value for name, value in sorted(os.environ.items())
            if name.startswith('GEMINI_API_KEY_') and name != 'GEMINI_API_KEY_ONLY' and value]
    for slot, key in enumerate(keys, 1):
        try:
            response = httpx.get('https://generativelanguage.googleapis.com/v1beta/models/' + JUDGE,
                                 headers={'x-goog-api-key': key}, timeout=15)
            record = {'key_slot': slot, 'status': response.status_code}
            if response.status_code == 200:
                value = response.json()
                record['model'] = {field: value.get(field) for field in ('name', 'version', 'displayName')}
            result['gemini'].append(record)
            if response.status_code == 200:
                break
        except httpx.HTTPError as exc:
            result['gemini'].append({'key_slot': slot, 'error': type(exc).__name__})
    write(p.ST / 'preflight.json', result)
    print(json.dumps(result, indent=2), flush=True)
    return 0 if any(row.get('status') == 200 for row in result['gemini']) else 2


