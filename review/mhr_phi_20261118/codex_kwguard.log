from collections import Counter
import hashlib
import json
from pathlib import Path

from reproduce.mhr_phi import c0, profile, runtime

profile.apply(offline=True)
phased = runtime.phased_runner()
from minirag.prompt import PROMPTS

cohort = c0.Cohort('test', 202)
dest = cohort.dest
source = c0.OFFLINE / 'kwguard_s202_before.json'
baseline = runtime.read(source)

def rows(path):
    data = path.read_bytes()
    assert data.endswith(b'\\n'), path
    return [json.loads(line) for line in data.split(b'\\n')[:-1]]

for name, recorded in baseline.items():
    path = profile.OUT / name
    with path.open('rb') as handle:
        prefix = handle.read(recorded['bytes'])
    assert hashlib.sha256(prefix).hexdigest() == recorded['sha256'], name
    assert prefix.count(b'\\n') == recorded['lines']
    if path.parent.name "'!= '"'worker1':
        assert path.stat().st_size == recorded['bytes'], name

summary = runtime.read(dest / 'contexts_summary.json')
c0.require_hashes(dest, summary['files_sha256'])
assert runtime.sha(cohort.keywords) == summary['keyword_sha256']
