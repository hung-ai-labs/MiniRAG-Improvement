f_rows = [fail if key == qid else {'query_id': key, 'status': 'no_context', 'context': None} for key in ids]
pools = [{'query_id': key, 'status': 'early_exit' if key == qid else 'no_context', 'final_full': []} for key in ids]
metadata = dict.fromkeys(('contexts_sha256', 'pools_sha256', 'model_F_sha256', 'model_CE_sha256', 'chunks_sha256',
    'index_manifest_sha256', 'ce_logits_test_sha256', 'ce_logits_test_summary_sha256',
    'ce_logits_dev_sha256', 'offline_eval_sha256'), 'sample') | {'checks': {'passed': True}}

def read(path):
    return {} if path.name in ('chunks_text.json', 'kv_store_text_chunks.json') else metadata

def records(path):
    return pools if path.name == 'pools.jsonl' else f_rows

values = {ce: {'MODEL': model, 'OUT': out/'ce', 'read': read, 'records': records, 'sha': lambda path: 'sample'},
          set_run: {'PARAMS': model, 'OUT': out/'set', 'read': read, 'sha': lambda path: 'sample',
                    'frozen': lambda: {'beta': 1, 'tau': 0}}}
with ExitStack() as stack:
    for module, replacements in values.items():
        stack.enter_context(patch.multiple(module, **replacements))
    stack.enter_context(patch.object(kwguard, 'EVENTS', events))
    stack.enter_context(patch.object(ce.offline, 'wait_test_logits'))
    stack.enter_context(patch.object(ce.offline, 'logits', return_value=dict.fromkeys(ids, {})))
    stack.enter_context(patch.object(set_run.base, 'corpus', return_value=({}, {}, {})))
    write_rows = stack.enter_context(patch.object(ce.offline, 'jsonl'))
    write_summary = stack.enter_context(patch.object(ce.offline, 'write'))
    assert ce.contexts(SimpleNamespace(seed=202)) == 0
    ce_rows = write_rows.call_args.args[1]
    ce_summary = write_summary.call_args.args[1]
    with (patch.object(set_run, 'records', side_effect=lambda path: pools if path.name == 'pools.jsonl' else ce_rows),
          patch.object(set_run.offline, 'jsonl') as set_rows, patch.object(set_run.offline, 'write') as set_summary):
        assert set_run.contexts(SimpleNamespace(seed=202)) == 0
        set_values = set_rows.call_args.args[1]
        summary = set_summary.call_args.args[1]
    for context_rows, receipt in ((ce_rows, ce_summary), (set_values, summary)):
        case = next(row for row in context_rows if row['query_id'] == qid)
        assert all(case[field] == value for field, value in fail.items())
        assert case['chunk_ids'] == [] and receipt['keyword_guard_count'] == 1
expected = {'query_id': qid, 'seed': 202, 'split': 'test', 'reason': reason}
assert [json.loads(line) for line in events.read_text(encoding='utf-8').splitlines()] == [expected, expected]
print('CE and SET retained the guarded failure and counted it in each summary')
