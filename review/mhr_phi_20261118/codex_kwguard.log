    def test_subprocess_run_and_popen_propagate_profile(self):
        prefix = [sys.executable, '-B', '-u', '-m']
        for name in ('reproduce.mhr_st.run', 'reproduce.mhr_st.judge', 'reproduce.mhr_f.pool',
