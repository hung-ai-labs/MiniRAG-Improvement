@@ -0,0 +1,417 @@
+"""Three-phase Phi C0, using the frozen MiniRAG QA runner."""
+
+import argparse
+import asyncio
+from collections import Counter
+import csv
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import xml.etree.ElementTree as ET
+
+from . import profile as p, runtime
+from .launch import C0_MODULE, install_subprocess_rewrite
+
+WORKERS = 3
+HASH_SEED = '13'
+OFFLINE = p.OUT / '_offline_test'
+COHORTS = (('dev', 101), *(('test', seed) for seed in runtime.SEEDS))
+
+
+@dataclass(frozen=True)
+class Cohort:
+    split: str
+    seed: int
+    pilot_dir: Path | None = None
+
+    @property
+    def dest(self):
+        if self.pilot_dir:
+            return self.pilot_dir / 'C0_s101'
+        if self.split == 'dev':
+            return p.DEV_C0
+        return p.ARCHIVE / f'qa/s{self.seed}/C0_s{self.seed}'
+
+    @property
+    def index(self):
+        return p.PILOT if self.pilot_dir else p.INDEX
+
+    @property
+    def keywords(self):
+        if self.pilot_dir:
+            return self.pilot_dir / 'synthetic_kw.jsonl'
+        if self.split == 'dev':
+            return p.ST / 'inputs/kw_dev_s101.jsonl'
+        return p.ST / f's{self.seed}/kw_s{self.seed}.jsonl'
+
+    def rows(self):
+        rows = runtime.questions(self.split)
+        return rows[:5] if self.pilot_dir else rows
+
+
+def write_json(path, value, *, fresh=False):
+    if fresh:
+        with path.open('x', encoding='utf-8', newline='\n') as handle:
+            json.dump(value, handle, indent=2, ensure_ascii=False)
+            handle.write('\n')
+    else:
+        runtime.phased_runner().qa_run.atomic_json(path, value)
+
+
+def write_records(path, rows, *, fresh=False):
+    target = path if fresh else path.with_suffix('.jsonl.tmp')
+    with target.open('x' if fresh else 'w', encoding='utf-8', newline='\n') as handle:
+        for row in rows:
+            handle.write(json.dumps(row, ensure_ascii=False) + '\n')
+    if not fresh:
+        os.replace(target, path)
+
+
+def artifact_hashes(root, names):
+    return {name: runtime.sha(root / name) for name in names}
+
+
+def require_hashes(root, hashes):
+    if artifact_hashes(root, hashes) != hashes:
+        raise RuntimeError(f'C0 checkpoint files changed in {root}')
+
+
+def identity(cohort, phased):
+    return {'split': cohort.split, 'seed': cohort.seed, 'index': str(cohort.index),
+            'index_manifest_sha256': runtime.sha(cohort.index / 'index_manifest.json'),
+            'questions_sha256': runtime.QUESTION_HASHES[cohort.split],
+            'frozen_source_sha256': runtime.sha(p.OUT / 'frozen_source_sha256.json'),
+            'serving_spec_sha256': runtime.sha(p.SERVING), 'model': p.MODEL,
+            'mode': phased.MODE['C0'], 'environment': phased.config_env('C0'),
+            'python_hash_seed': int(HASH_SEED), 'workers': WORKERS, 'llm_max_async': 32,
+            'questions': len(cohort.rows())}
+
+
+def prepare(cohort, phased):
+    cohort.dest.mkdir(parents=True, exist_ok=True)
+    runtime.source_checks()
+    runtime.verify_index(cohort.index, pilot=bool(cohort.pilot_dir))
+    expected = identity(cohort, phased)
+    file = cohort.dest / 'run_note.json'
+    if file.exists():
+        if runtime.read(file) != expected:
+            raise RuntimeError('C0 run identity changed')
+    else:
+        write_json(file, expected, fresh=bool(cohort.pilot_dir))
+
+
+def require_keyword_cache(cohort, phased):
+    if not cohort.pilot_dir:
+        receipt = runtime.read(cohort.dest / 'keywords_summary.json')
+        if receipt['sha256'] != runtime.sha(cohort.keywords):
+            raise RuntimeError('Frozen Phi keyword cache changed')
+    cached = phased.read_jsonl(cohort.keywords, key='query_id')
+    wanted = {r['query_id'] for r in cohort.rows()}
+    if cached.keys() != wanted or not all(
+        {'prompt_sha256', 'result', 'query_id'} == row.keys() for row in cached.values()
+    ):
+        raise RuntimeError('Frozen keyword cache has incomplete or unexpected records')
+
+
+def keywords(cohort, phased):
+    receipt = cohort.dest / 'keywords_summary.json'
+    if receipt.exists():
+        require_keyword_cache(cohort, phased)
+        print(f'{cohort.split} s{cohort.seed}: keyword cache already complete', flush=True)
+        return
+    rows = cohort.rows()
+    cohort.keywords.parent.mkdir(parents=True, exist_ok=True)
+    phased.apply_env('C0', cohort.seed)
+    trace_dir = cohort.dest / 'keywords'
+    trace_dir.mkdir(exist_ok=True)
+    serving = runtime.check_serving()
+    phased.apply_env('C0', cohort.seed, kw_cache=cohort.keywords)
+    write_json(trace_dir / 'serving_check.json', serving)
+    snapshot = trace_dir / 'snapshot'
+    if not snapshot.exists():
+        phased.snapshot(snapshot, cohort.index)
+    # Index input files are immutable. The runner's private log/cache can append.
+    fixed = runtime.read(cohort.index / 'index_manifest.json')['file_sha256']
+    require_hashes(snapshot, {name: value for name, value in fixed.items()
+                              if name != 'kv_store_llm_response_cache.json'})
+
+    async def run():
+        rag = phased.build(snapshot, llm_max_async=32)
+        await phased.keyword_phase(rag, rows, cohort.keywords)
+
+    phased.traced(trace_dir, run)
+    if phased.read_jsonl(cohort.keywords, key='query_id').keys() != {row['query_id'] for row in rows}:
+        raise RuntimeError('Keyword phase incomplete; rerun to resume')
+    write_json(receipt, {'questions': len(rows), 'sha256': runtime.sha(cohort.keywords)})
+    print(f'{cohort.split} s{cohort.seed}: {len(rows)} keyword records', flush=True)
+
+
+async def _phase3_c0(phased, rag, rows, output):
+    """Replay the C0 half of the phase-3 shared prefix/suffix worker."""
+    import time
+    from minirag import operate
+    from minirag.base import QueryParam
+    from minirag.prompt import PROMPTS
+    from research.mhr_phase3.shared_context import SharedContext, context_record
+
+    adapter = SharedContext(operate)
+    done = phased.read_jsonl(output)
+    with adapter.installed(), output.open('a', encoding='utf-8', newline='\n') as handle:
+        for row in rows:
+            if row['query_id'] in done:
+                continue
+            adapter.clear()
+            started = time.perf_counter()
+            value = await rag.aquery(row['Question'], param=QueryParam(mode='mini', only_need_context=True))
+            phased.append_jsonl(handle, context_record(row['query_id'], value, PROMPTS['fail_response'],
+                                                       time.perf_counter() - started))
+
+
+def context_worker(cohort, phased, shard):
+    if os.environ.get('PYTHONHASHSEED') != HASH_SEED:
+        raise RuntimeError('C0 context worker requires PYTHONHASHSEED=13 set before startup')
+    for name in runtime.RETRIEVAL_OVERRIDES:
+        os.environ.pop(name, None)
+    dest = cohort.dest / f'worker{shard}'
+    snapshot = dest / 'snapshot'
+    if not snapshot.exists():
+        phased.snapshot(snapshot, cohort.index)
+    require_hashes(snapshot, runtime.read(cohort.index / 'index_manifest.json')['file_sha256'])
+    phased.apply_env('C0', cohort.seed, kw_cache=cohort.keywords, cache_only=True,
+                     context_log=dest / 'context.jsonl')
+    rag = phased.build(snapshot, llm_max_async=1)
+    rows = cohort.rows()[shard::WORKERS]
+    output = dest / 'contexts.jsonl'
+    if cohort.split == 'test':
+        asyncio.run(_phase3_c0(phased, rag, rows, output))
+    else:
+        asyncio.run(phased.context_phase(rag, rows, phased.MODE['C0'], output))
+
+
+def child_command(step, cohort):
+    args = [sys.executable, '-B', '-u', '-m', C0_MODULE, step, '--split', cohort.split,
+            '--seed', str(cohort.seed)]
+    if cohort.pilot_dir:
+        args += ['--pilot-dir', str(cohort.pilot_dir)]
+    return args
+
+
+def contexts(cohort, phased):
+    require_keyword_cache(cohort, phased)
+    receipt = cohort.dest / 'contexts_summary.json'
+    kw_hash = runtime.sha(cohort.keywords)
+    if receipt.exists():
+        summary = runtime.read(receipt)
+        if summary['keyword_sha256'] != kw_hash:
+            raise RuntimeError('Frozen keyword cache changed since phase B')
+        require_hashes(cohort.dest, summary['files_sha256'])
+        print(f'{cohort.split} s{cohort.seed}: contexts already complete', flush=True)
+        return
+    frozen_file = cohort.dest / 'context_identity.json'
+    if frozen_file.exists() and runtime.read(frozen_file)['keyword_sha256'] != kw_hash:
+        raise RuntimeError('Frozen keyword cache changed during phase B')
+    if not frozen_file.exists():
+        write_json(frozen_file, {'keyword_sha256': kw_hash}, fresh=bool(cohort.pilot_dir))
+
+    processes = []
+    try:
+        for shard in range(WORKERS):
+            path = cohort.dest / f'worker{shard}'
+            path.mkdir(exist_ok=True)
+            with (path / 'worker.log').open('a', encoding='utf-8') as handle:
+                processes.append(subprocess.Popen(
+                    child_command('context-worker', cohort) + ['--shard', str(shard)], cwd=p.ROOT,
+                    env=os.environ | {'PYTHONHASHSEED': HASH_SEED, 'PYTHONUTF8': '1'},
+                    stdout=handle, stderr=subprocess.STDOUT))
+        codes = [process.wait() for process in processes]
+    finally:
+        for process in processes:
+            if process.poll() is None:
+                process.terminate()
+                process.wait()
+    if any(codes):
+        raise RuntimeError(f'C0 context workers failed: {codes}. See {cohort.dest}/worker*/worker.log')
+
+    rows = cohort.rows()
+    parts, logs = {}, []
+    for shard in range(WORKERS):
+        dest = cohort.dest / f'worker{shard}'
+        part = phased.read_jsonl(dest / 'contexts.jsonl')
+        expected = {row['query_id'] for row in rows[shard::WORKERS]}
+        if part.keys() != expected:
+            raise RuntimeError(f'C0 context shard {shard} has incomplete or unexpected rows')
+        parts.update(part)
+        shard_logs = phased.read_jsonl(dest / 'context.jsonl', key='query')
+        logs.extend(shard_logs.values())
+    merged = [parts[row['query_id']] for row in rows]
+    write_records(cohort.dest / 'contexts.jsonl', merged, fresh=bool(cohort.pilot_dir))
+    write_records(cohort.dest / 'context.jsonl', logs, fresh=bool(cohort.pilot_dir))
+    summary = {'questions': len(merged), 'statuses': dict(Counter(row['status'] for row in merged)),
+               'retrieval_log_records': len(logs), 'llm_calls': 0, 'worker_exit_codes': codes,
+               'kw_cache_only': True, 'keyword_sha256': kw_hash,
+               'files_sha256': artifact_hashes(cohort.dest, ('contexts.jsonl', 'context.jsonl'))}
+    write_json(receipt, summary, fresh=bool(cohort.pilot_dir))
+    print(json.dumps(summary, indent=2), flush=True)
+
+
+def answers(cohort, phased):
+    from minirag.base import QueryParam
+
+    receipt = cohort.dest / 'answers_summary.json'
+    if receipt.exists():
+        require_completed(cohort.split, cohort.seed)
+        print(f'{cohort.split} s{cohort.seed}: answers already complete', flush=True)
+        return
+    summary = runtime.read(cohort.dest / 'contexts_summary.json')
+    require_keyword_cache(cohort, phased)
+    if summary['keyword_sha256'] != runtime.sha(cohort.keywords):
+        raise RuntimeError('Frozen keyword cache no longer matches the contexts')
+    require_hashes(cohort.dest, summary['files_sha256'])
+    rows = cohort.rows()
+    retrieved = phased.read_jsonl(cohort.dest / 'contexts.jsonl')
+    wanted = {row['query_id'] for row in rows}
+    if retrieved.keys() != wanted:
+        raise RuntimeError('Incomplete contexts; refusing generation')
+    phased.apply_env('C0', cohort.seed)
+    write_json(cohort.dest / 'serving_check.json', runtime.check_serving())
+
+    async def run():
+        rag = phased.build(cohort.dest / 'answer_work', llm_max_async=32)
+        await phased.answer_phase(rag.llm_model_func, rows, retrieved, phased.MODE['C0'],
+                                  cohort.dest / 'answers.jsonl', QueryParam().response_type)
+
+    phased.traced(cohort.dest, run)
+    generated = phased.read_jsonl(cohort.dest / 'answers.jsonl')
+    if generated.keys() != wanted:
+        raise RuntimeError('Answer phase incomplete; rerun to resume')
+    write_json(receipt, {'questions': len(generated),
+                         'files_sha256': artifact_hashes(cohort.dest, ('answers.jsonl', 'answers.csv', 'requests.jsonl')),
+                         'contexts_sha256': summary['files_sha256']['contexts.jsonl']})
+    print(f'{cohort.split} s{cohort.seed}: {len(generated)} answers', flush=True)
+
+
+def require_completed(split, seed):
+    cohort = Cohort(split, seed)
+    phased = runtime.phased_runner()
+    if runtime.read(cohort.dest / 'run_note.json') != identity(cohort, phased):
+        raise RuntimeError(f'Completed {split} s{seed} C0 belongs to another index or configuration')
+    require_keyword_cache(cohort, phased)
+    ctx = runtime.read(cohort.dest / 'contexts_summary.json')
+    ans = runtime.read(cohort.dest / 'answers_summary.json')
+    require_hashes(cohort.dest, ctx['files_sha256'] | ans['files_sha256'])
+    if (ctx['keyword_sha256'] != runtime.sha(cohort.keywords)
+            or ans['contexts_sha256'] != ctx['files_sha256']['contexts.jsonl']):
+        raise RuntimeError(f'Completed {split} s{seed} C0 phase hashes disagree')
+
+
+def execute(phased):
+    p.C0.mkdir(parents=True, exist_ok=True)
+    status = p.C0 / 'status.json'
+    completed = []
+    with phased.qa_run.run_lock(p.C0):
+        try:
+            for split, seed in COHORTS:
+                cohort = Cohort(split, seed)
+                for step in ('keywords', 'contexts', 'answers'):
+                    write_json(status, {'state': 'running', 'at': runtime.now(), 'phase': step,
+                                        'split': split, 'seed': seed, 'completed_cohorts': completed})
+                    subprocess.run(child_command(step, cohort), cwd=p.ROOT, check=True)
+                completed.append({'split': split, 'seed': seed})
+            write_json(status, {'state': 'completed', 'at': runtime.now(), 'completed_cohorts': completed})
+        except BaseException as exc:
+            write_json(status, {'state': 'failed', 'at': runtime.now(), 'phase': step,
+                                'split': split, 'seed': seed, 'completed_cohorts': completed,
+                                'error_type': type(exc).__name__})
+            raise
+
+
+def pilot_fixture():
+    """Re-key five copied Qwen keyword responses for the pilot's own TYPE_POOL."""
+    from minirag.prompt import PROMPTS
+
+    OFFLINE.mkdir(parents=True, exist_ok=True)
+    root = Path(tempfile.mkdtemp(prefix='c0_pilot_', dir=OFFLINE))
+    wanted = {row['query_id']: row for row in runtime.questions('dev')[:5]}
+    source = p.SHARED_INPUTS / 'kw_dev_s101.jsonl'
+    originals = {}
+    with source.open('rb') as handle:
+        for line in handle:
+            record = json.loads(line)
+            if record['query_id'] in wanted:
+                originals[record['query_id']] = (line, record)
+    if originals.keys() != wanted.keys():
+        raise RuntimeError('Missing Qwen keyword results for the pilot questions')
+    with (root / 'qwen_keyword_records.jsonl').open('xb') as handle:
+        for qid in wanted:
+            handle.write(originals[qid][0])
+
+    graph = ET.parse(p.PILOT / 'graph_chunk_entity_relation.graphml')
+    ns = {'g': 'http://graphml.graphdrawing.org/xmlns'}
+    entity_type = next(key.get('id') for key in graph.findall('g:key', ns)
+                       if key.get('attr.name') == 'entity_type' and key.get('for') == 'node')
+    types = sorted({value.text.lower() for value in graph.findall('g:graph/g:node/g:data', ns)
+                    if value.get('key') == entity_type and value.text})
+    synthetic = []
+    for qid, row in wanted.items():
+        prompt = PROMPTS['minirag_query2kwd'].format(query=row['Question'], TYPE_POOL=types)
+        prompt_sha = hashlib.sha256(prompt.encode('utf-8')).hexdigest()
+        synthetic.append(originals[qid][1] | {'prompt_sha256': prompt_sha})
+    write_records(root / 'synthetic_kw.jsonl', synthetic, fresh=True)
+    write_json(root / 'fixture.json', {'question_ids': list(wanted), 'copied_from': str(source),
+               'pilot_type_count': len(types), 'rekeyed': sum(
+                   row['prompt_sha256'] != originals[row['query_id']][1]['prompt_sha256'] for row in synthetic),
+               'synthetic_keyword_sha256': runtime.sha(root / 'synthetic_kw.jsonl')}, fresh=True)
+    return root
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('step', choices=('keywords', 'contexts', 'answers', 'execute', 'context-worker'))
+    parser.add_argument('--split', choices=('dev', 'test'), default='test')
+    parser.add_argument('--seed', type=int, choices=runtime.SEEDS, default=101)
+    parser.add_argument('--pilot-test', action='store_true', help='offline five-question dev pilot')
+    parser.add_argument('--pilot-dir', type=Path, help=argparse.SUPPRESS)
+    parser.add_argument('--shard', type=int, choices=range(WORKERS), help=argparse.SUPPRESS)
+    args = parser.parse_args()
+    if args.split == 'dev' and args.seed != 101:
+        parser.error('dev C0 uses seed 101 only')
+    if args.pilot_test and (args.step, args.split, args.seed) != ('contexts', 'dev', 101):
+        parser.error('--pilot-test requires contexts --split dev --seed 101')
+    if args.step == 'context-worker' and args.shard is None:
+        parser.error('context-worker requires --shard')
+    if args.pilot_dir is not None:
+        args.pilot_dir = args.pilot_dir.resolve()
+        if (args.step != 'context-worker' or args.split != 'dev' or args.pilot_dir.parent != OFFLINE
+                or not args.pilot_dir.name.startswith('c0_pilot_')):
+            parser.error('--pilot-dir is reserved for offline dev pilot workers')
+    offline = args.step in ('contexts', 'context-worker')
+    if not offline and not p._installed:
+        parser.error('invoke online C0 phases through reproduce.mhr_phi.launch')
+    p.apply(offline=offline)
+    install_subprocess_rewrite()
+    phased = runtime.phased_runner()
+    if args.step == 'execute':
+        return execute(phased)
+    cohort = Cohort(args.split, args.seed, pilot_fixture() if args.pilot_test else args.pilot_dir)
+    if args.step == 'context-worker':
+        return context_worker(cohort, phased, args.shard)
+    prepare(cohort, phased)
+    operations = {'keywords': keywords, 'contexts': contexts, 'answers': answers}
+    if cohort.pilot_dir:
+        contexts(cohort, phased)
+        if (cohort.dest / 'requests.jsonl').exists():
+            raise RuntimeError('Offline phase B unexpectedly wrote a request trace')
+        print(f'Offline pilot artifacts: {cohort.pilot_dir}', flush=True)
+        return 0
+    with phased.qa_run.run_lock(cohort.dest):
+        operations[args.step](cohort, phased)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/reproduce/mhr_phi/launch.py b/reproduce/mhr_phi/launch.py
new file mode 100644
index 0000000000000000000000000000000000000000..2cb37b94c5cd038d6eab76a33a7db40b8eff0ecb
--- /dev/null
+++ b/reproduce/mhr_phi/launch.py
@@ -0,0 +1,115 @@
+"""Run a ladder module as __main__ with the Phi profile and inherited credentials."""
+
+import os
+from pathlib import Path
+import runpy
+import subprocess
+import sys
+
+from . import profile
+
+MODULE = 'reproduce.mhr_phi.launch'
+C0_MODULE = 'reproduce.mhr_phi.c0'
+_INHERITED = '_MHR_PHI_LAUNCH_ENV'
+_ONLINE = {
+    C0_MODULE: {'keywords', 'answers', 'execute'},
+    'reproduce.mhr_st.run': {'preflight', 'answers', 'execute'},
+    'reproduce.mhr_f.run': {'answers', 'execute', 'finish'},
+    'reproduce.mhr_ce.run': {'answers', 'execute', 'finish'},
+    'reproduce.mhr_set.run': {'answers', 'execute', 'finish'},
+}
+_ALWAYS_ONLINE = {
+    'reproduce.mhr_st.judge', 'reproduce.mhr_st.finish', 'reproduce.mhr_ce.scores',
+    'reproduce.mhr_ce.judge_entry', 'reproduce.mhr_set.judge_entry',
+    'reproduce.mhr_ce.online', 'reproduce.mhr_set.online',
+}
+
+
+def _profiled(module):
+    return profile.is_ladder(module) or module == C0_MODULE
+
+
+def rewrite_command(command):
+    if (not isinstance(command, (list, tuple)) or not command
+            or not isinstance(command[0], (str, os.PathLike))
+            or Path(command[0]).resolve() != Path(sys.executable).resolve()):
+        return command
+    # Only inspect interpreter options. A script may have its own unrelated -m.
+    arguments = list(command)
+    index = 1
+    while index < len(arguments):
+        option = arguments[index]
+        if not isinstance(option, str) or not option.startswith('-') or option in ('-', '--', '-c'):
+            break
+        if option == '-m':
+            if index + 1 < len(arguments) and _profiled(arguments[index + 1]):
+                return arguments[:index + 1] + [MODULE] + arguments[index + 1:]
+            break
+        index += 2 if option in ('-W', '-X') else 1
+    return command
+
+
+def install_subprocess_rewrite():
+    """subprocess.run and check_output also go through subprocess.Popen."""
+    original = subprocess.Popen
+    if getattr(original, '_phi_launcher', False):
+        return
+
+    class ProfiledPopen(original):
+        _phi_launcher = True
+
+        def __init__(self, args, *positional, **kwargs):
+            rewritten = rewrite_command(args)
+            if rewritten is not args:
+                env = kwargs.get('env')
+                kwargs['env'] = dict(os.environ if env is None else env) | {_INHERITED: '1'}
+                kwargs['env']['PYTHONDONTWRITEBYTECODE'] = '1'
+            super().__init__(rewritten, *positional, **kwargs)
+
+    subprocess.Popen = ProfiledPopen
+
+
+def _is_online(module, args):
+    if any(arg in ('-h', '--help') for arg in args):
+        return False
+    step = args[0] if args else None
+    return module in _ALWAYS_ONLINE or step in _ONLINE.get(module, ())
+
+
+def main():
+    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help'):
+        print('usage: python -B -m reproduce.mhr_phi.launch <module> [args]')
+        return 0
+    module, *args = sys.argv[1:]
+    if not _profiled(module):
+        raise SystemExit(f'Unsupported Phi ladder module: {module}')
+    if Path.cwd().resolve() != profile.ROOT:
+        raise SystemExit(f'Run the Phi launcher from the repository root: {profile.ROOT}')
+
+    online = _is_online(module, args)
+    inherited = os.environ.pop(_INHERITED, None) == '1'
+    import dotenv
+    load_dotenv = dotenv.load_dotenv
+    profile.apply(offline=not online)
+    if online and not inherited:
+        dotenv_path = os.environ.get('MINIRAG_DOTENV')
+        if not dotenv_path:
+            raise SystemExit('Set MINIRAG_DOTENV to the credential file before running online commands')
+        with profile._launcher_dotenv(dotenv_path) as path:
+            load_dotenv(path, override=False)
+    url = os.environ.get('PHI_SLM_URL', '').strip()
+    if online and not url:
+        raise SystemExit('Set PHI_SLM_URL to the Phi LongRoPE serving endpoint')
+    if url:
+        os.environ['MINIRAG_SLM_URL'] = url
+    if 'PYTHONUTF8' not in os.environ:
+        os.environ['PYTHONUTF8'] = '1'
+    os.environ['PYTHONDONTWRITEBYTECODE'] = '1'
+    install_subprocess_rewrite()
+    sys.argv = [module, *args]
+    runpy.run_module(module, run_name='__main__', alter_sys=True)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/reproduce/mhr_phi/profile.py b/reproduce/mhr_phi/profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e66cd3a1488543e481b04e73eaa6e49e571ca92
--- /dev/null
+++ b/reproduce/mhr_phi/profile.py
@@ -0,0 +1,222 @@
+"""Select Phi before importing or running any of the frozen ladder modules."""
+
+import ast
+from contextlib import contextmanager
+from contextvars import ContextVar
+from importlib.machinery import PathFinder, SourceFileLoader
+import os
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / 'review/mhr_phi_20261118'
+ST = OUT / 'st'
+F = OUT / 'f'
+CE = OUT / 'ce'
+SET = OUT / 'set'
+C0 = OUT / 'c0'
+ARCHIVE = C0 / 'archive'
+DEV_C0 = C0 / 'dev/C0_s101'
+INDEX = ROOT / 'MultiHop-RAG-phi-ropefix609'
+PILOT = OUT / 'index_source/indexes/multihop_rag-phi-pilot30'
+SERVING = OUT / 'serving_phi_ropefix_modal.json'
+MODEL = 'microsoft/Phi-3.5-mini-instruct'
+TITLE = 'Phi-3.5-mini-instruct (LongRoPE fix)'
+PACKAGES = tuple(f'reproduce.mhr_{row}' for row in ('st', 'f', 'ce', 'set'))
+QWEN_PATHS = {
+    'review/mhr_st_20261112': 'ST',
+    'review/mhr_f_20261114': 'F',
+    'review/mhr_ce_20261116': 'CE',
+    'review/mhr_set_20261117': 'SET',
+    'MultiHop-RAG-qwen-full609': 'INDEX',
+}
+QWEN_ROOTS = tuple(ROOT / path for path in QWEN_PATHS)
+SHARED_SOURCE = QWEN_ROOTS[0] / 'source'
+SHARED_INPUTS = QWEN_ROOTS[0] / 'inputs'
+EMBEDDING_RECEIPT = QWEN_ROOTS[0] / 'embedding_cache.json'
+
+_dotenv_read = ContextVar('phi_dotenv_read', default=None)
+_installed = False
+_network_denied = False
+
+
+def is_ladder(name):
+    return any(name == package or name.startswith(package + '.') for package in PACKAGES)
+
+
+def _path(value):
+    if isinstance(value, (str, bytes, os.PathLike)):
+        return Path(os.fsdecode(value))
+    return None
+
+
+def _protect(path):
+    if path is None:
+        return
+    literal = Path(os.path.abspath(path))
+    resolved = path.resolve()
+    if any(candidate.is_relative_to(root) for candidate in (literal, resolved) for root in QWEN_ROOTS):
+        raise PermissionError(f'Qwen artifact is read-only under the Phi profile: {path}')
+
+
+def _audit(event, args):
+    if _network_denied and (event.startswith('socket.') or event == 'http.client.connect'):
+        # socket.__new__ is also blocked to catch any attempted endpoint client use.
+        raise PermissionError(f'Network is disabled for offline Phi work: {event}')
+    if event == 'open':
+        path = _path(args[0])
+        if path is None:
+            return
+        mode, flags = args[1:]
+        writing = bool((mode and any(flag in mode for flag in 'wax+')) or (
+            flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND)))
+        allowed = _dotenv_read.get()
+        names = (path.name.lower(), path.resolve().name.lower()) if not writing else (path.name.lower(),)
+        if any(name == '.env' or name.startswith('.env.') for name in names) or (
+            allowed is not None and path.resolve() == allowed
+        ):
+            if writing or allowed is None or path.resolve() != allowed:
+                raise PermissionError('Only the Phi launcher may read its explicitly selected dotenv file')
+        if writing:
+            _protect(path)
+    elif event in ('os.rename', 'os.link', 'os.symlink'):
+        for value in args[:2]:
+            _protect(_path(value))
+    elif event in ('os.mkdir', 'os.remove', 'os.rmdir', 'os.chmod', 'os.chown',
+                   'os.utime', 'os.truncate', 'os.chflags', 'shutil.rmtree'):
+        _protect(_path(args[0]))
+
+
+@contextmanager
+def _launcher_dotenv(path):
+    allowed = Path(path).resolve(strict=True)
+    token = _dotenv_read.set(allowed)
+    try:
+        yield allowed
+    finally:
+        _dotenv_read.reset(token)
+
+
+def no_dotenv(*args, **kwargs):
+    return False
+
+
+# These are the function-local exceptions found in the AST scan. Ordinary
+# imported aliases and derived constants evaluate normally after the rewrite.
+_FUNCTIONS = {
+    'mhr_st.common': {'setup': 'return _phi_runtime.setup(source)'},
+    'mhr_st.run': {'prepare': 'return _phi_runtime.prepare_st()',
+                   'preflight': 'return _phi_runtime.preflight_st()'},
+    'mhr_st.finish': {'amendment': 'return None'},
+    'mhr_ce.offline': {'setup': ('from reproduce.mhr_f import study\n'
+                                 'study.setup = setup\n'
+                                 'return _phi_runtime.setup(source)')},
+}
+_PATH_EXPRESSIONS = {
+    "OUT / 'archive_c0'": 'ARCHIVE',
+    "ROOT / 'runs/multihop_rag/dev400/C0_s101'": 'DEV_C0',
+    "ROOT.parent / 'MiniRAG/runs/multihop_rag/dev400/C0_s101/context.jsonl'": 'DEV_C0 / "context.jsonl"',
+    "OUT / 'source'": 'SHARED_SOURCE',
+    "ST_OUT / 'source'": 'SHARED_SOURCE',
+    "ST_OUT / 'embedding_cache.json'": 'EMBEDDING_RECEIPT',
+    "OUT / 'embedding_cache.json'": 'EMBEDDING_RECEIPT',
+}
+
+
+class _PhiSource(ast.NodeTransformer):
+    def __init__(self, module):
+        self.module = module.removeprefix('reproduce.')
+
+    def visit_FunctionDef(self, node):
+        replacement = _FUNCTIONS.get(self.module, {}).get(node.name)
+        if replacement:
+            node.body = ast.parse(replacement).body
+            return node
+        if self.module == 'mhr_st.pipeline' and node.name == 'execute':
+            # The original execute judges all ST answers before finish can apply
+            # the registered identical-answer reuse. Let finish do the judging.
+            block = node.body[0]
+            first = next(i for i, statement in enumerate(block.body)
+                         if isinstance(statement, ast.For)
+                         and "judge('test', seed)" in ast.unparse(statement))
+            block.body[first:-1] = ast.parse(
+                "write(OUT / 'status.json', {'state': 'contexts_and_answers_done'})").body
+        return self.generic_visit(node)
+
+    def visit_BinOp(self, node):
+        if not isinstance(node.op, ast.Div):
+            return self.generic_visit(node)
+        replacement = _PATH_EXPRESSIONS.get(ast.unparse(node))
+        if replacement:
+            return ast.copy_location(ast.parse('_phi.' + replacement, mode='eval').body, node)
+        if isinstance(node.right, ast.Constant) and isinstance(node.right.value, str):
+            path = node.right.value
+            if path == 'source/reproduce/research/serving_qwen_modal.json':
+                return ast.copy_location(ast.parse('_phi.SERVING', mode='eval').body, node)
+            if path.startswith('source/'):
+                return ast.copy_location(ast.parse(
+                    f'_phi.SHARED_SOURCE / {path.removeprefix("source/")!r}', mode='eval').body, node)
+        if (isinstance(node.right, ast.JoinedStr)
+                and isinstance(node.right.values[0], ast.Constant)
+                and node.right.values[0].value.startswith('archive_c0/')):
+            node.left = ast.parse('_phi.ARCHIVE', mode='eval').body
+            node.right.values[0].value = node.right.values[0].value.removeprefix('archive_c0/')
+        return self.generic_visit(node)
+
+    def visit_Constant(self, node):
+        if not isinstance(node.value, str):
+            return node
+        # The scores module constructs its review path from two segments.
+        if self.module == 'mhr_ce.scores' and node.value == 'mhr_ce_20261116':
+            node.value = 'mhr_phi_20261118/ce'
+        elif node.value in QWEN_PATHS:
+            node.value = str(globals()[QWEN_PATHS[node.value]].relative_to(ROOT))
+        elif 'Qwen2.5-3B | Judge:' in node.value:
+            node.value = node.value.replace('Qwen2.5-3B', TITLE)
+        elif node.value == 'SET vs F is secondary because CE was not confirmed over F.':
+            node.value = 'SET vs F is a registered secondary comparison.'
+        elif self.module == 'mhr_st.run' and 'MultiHop-RAG/Qwen benchmark' in node.value:
+            node.value = node.value.replace('MultiHop-RAG/Qwen benchmark', 'MultiHop-RAG/Phi benchmark')
+        return node
+
+
+class _PhiLoader(SourceFileLoader):
+    def get_code(self, fullname):
+        filename = self.get_filename(fullname)
+        tree = _PhiSource(fullname).visit(ast.parse(self.get_data(filename), filename))
+        # Preserve the docstring and future imports, for both ordinary imports
+        # and runpy's independent __main__ namespace.
+        first = int(bool(ast.get_docstring(tree, clean=False)))
+        while (first < len(tree.body) and isinstance(tree.body[first], ast.ImportFrom)
+               and tree.body[first].module == '__future__'):
+            first += 1
+        tree.body[first:first] = ast.parse(
+            'from reproduce.mhr_phi import profile as _phi, runtime as _phi_runtime').body
+        return compile(ast.fix_missing_locations(tree), filename, 'exec')
+
+
+class _PhiFinder:
+    def find_spec(self, fullname, path=None, target=None):
+        if not is_ladder(fullname):
+            return None
+        spec = PathFinder.find_spec(fullname, path)
+        if spec is not None and isinstance(spec.loader, SourceFileLoader):
+            spec.loader = _PhiLoader(fullname, spec.origin)
+        return spec
+
+
+def apply(*, offline=False):
+    """Install the profile before ladder import, with optional socket denial."""
+    global _installed, _network_denied
+    _network_denied |= offline
+    if _installed:
+        return
+    already_loaded = sorted(name for name in sys.modules if is_ladder(name))
+    if already_loaded:
+        raise RuntimeError(f'Apply the Phi profile before importing the ladder: {already_loaded}')
+    sys.dont_write_bytecode = True
+    sys.addaudithook(_audit)
+    sys.meta_path.insert(0, _PhiFinder())
+    import dotenv
+    dotenv.load_dotenv = no_dotenv
+    _installed = True
diff --git a/reproduce/mhr_phi/runtime.py b/reproduce/mhr_phi/runtime.py
new file mode 100644
index 0000000000000000000000000000000000000000..221656662ef006a6c0d6469a67a76b77fda100da
--- /dev/null
+++ b/reproduce/mhr_phi/runtime.py
@@ -0,0 +1,262 @@
+"""Shared frozen-source setup, index checks, and Phi serving validation."""
+
+import argparse
+import asyncio
+import csv
+from datetime import datetime, timezone
+import hashlib
+import importlib
+import json
+import os
+from pathlib import Path
+import sys
+from unittest.mock import patch
+
+from . import profile as p
+
+SEEDS = (101, 202, 303)
+JUDGE = 'gemini-3.5-flash-lite'
+QUESTION_HASHES = {
+    'dev': '4633ef777b747ef0fb8cca86457454eed64680432d899a3d5410afce2b63ef77',
+    'test': 'e37a4599e8485b5b76f6b60157648b60564f51ee7eceaeb6798f7dbd523d069d',
+}
+QUESTIONS_N = {'dev': 400, 'test': 2156}
+SOURCE_COMMIT = 'b640765fb6ac46a817d3d221e2d652240f9e0c6c'
+DOCS_SHA = '5816d2d43cb0bbd825f61414c1648c38e57b495c211b7d046936da0c32fd8077'
+RETRIEVAL_OVERRIDES = ('MINIRAG_PATH_PRUNE', 'MINIRAG_PATH_SCORE', 'MINIRAG_RERANK',
+                       'MINIRAG_MAX_TOKEN_TEXT_UNIT')
+_phased = None
+
+
+def read(path):
+    return json.loads(path.read_text(encoding='utf-8'))
+
+
+def sha(path):
+    with path.open('rb') as handle:
+        return hashlib.file_digest(handle, 'sha256').hexdigest()
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def questions(split):
+    path = p.ST / 'inputs' / f'{split}.csv'
+    if sha(path) != QUESTION_HASHES[split]:
+        raise RuntimeError(f'Frozen {split} question copy changed')
+    with path.open(encoding='utf-8-sig', newline='') as handle:
+        rows = list(csv.DictReader(handle))
+    if len(rows) != QUESTIONS_N[split] or len({r['query_id'] for r in rows}) != len(rows):
+        raise RuntimeError(f'Frozen {split} question count or IDs changed')
+    return rows
+
+
+def source_checks():
+    expected = read(p.OUT / 'frozen_source_sha256.json')
+    checks = {name: sha(p.SHARED_SOURCE / name) == digest for name, digest in expected.items()}
+    if not all(checks.values()):
+        raise RuntimeError(f'Frozen source changed: {[name for name, ok in checks.items() if not ok]}')
+    return checks
+
+
+def hf_cache():
+    local = p.ROOT / 'data/leef/cache/huggingface/hub'
+    return local if local.is_dir() else p.ROOT.parent / 'MiniRAG/data/leef/cache/huggingface/hub'
+
+
+def setup(source=None):
+    """Use the existing immutable snapshot and the local embedding cache."""
+    global _phased
+    source = Path(source or p.SHARED_SOURCE).resolve()
+    if source != p.SHARED_SOURCE.resolve():
+        raise ValueError('Phi ladder requires the frozen MiniRAG source')
+    for path in (source, source / 'reproduce', source / 'reproduce/research'):
+        if str(path) not in sys.path:
+            sys.path.insert(0, str(path))
+    os.environ.update(PYTHONUTF8='1', PYTHONDONTWRITEBYTECODE='1', HF_HUB_OFFLINE='1',
+                      TRANSFORMERS_OFFLINE='1', HF_DATASETS_OFFLINE='1',
+                      HF_HUB_DISABLE_TELEMETRY='1', TOP_K='60',
+                      HF_HUB_CACHE=str(hf_cache()), TIKTOKEN_CACHE_DIR=str(p.ROOT / 'data-gym-cache'))
+    if _phased is None:
+        phased = importlib.import_module('phased_qa')
+        if Path(phased.__file__).resolve() != source / 'reproduce/research/phased_qa.py':
+            raise RuntimeError('Loaded phased_qa from outside the frozen source')
+        phased.INDEX = p.INDEX
+        phased.snapshot.__defaults__ = (p.INDEX,)
+        phased.use_slm = configure_slm
+        phased.traced = traced
+        original_build = phased.build
+
+        def build(workdir, llm_max_async=32):
+            if os.environ.get('MINIRAG_KW_CACHE_ONLY') != '1':
+                return original_build(workdir, llm_max_async=llm_max_async)
+            # The Phase 3 offline worker used the same construction bypass.
+            # The LLM is replaced immediately, before any retrieval can run.
+            with patch('gemini_common._resolve_api_keys', return_value=[]):
+                rag = original_build(workdir, llm_max_async=llm_max_async)
+            rag.llm_model_func = phased._forbidden_llm
+            return rag
+
+        phased.build = build
+        _phased = phased
+    return source
+
+
+def phased_runner():
+    setup()
+    return _phased
+
+
+def configure_slm():
+    phased_runner().qa_run.configure_environment(argparse.Namespace(backend='modal'))
+    os.environ['MINIRAG_MAX_TOKENS'] = '1024'
+
+
+def serving_spec():
+    spec = read(p.SERVING)
+    if spec['model'] != p.MODEL or spec['vllm_version'] != '0.11.0':
+        raise RuntimeError('Serving spec differs from the registered Phi model or vLLM version')
+    return spec
+
+
+def check_serving():
+    import httpx
+
+    spec = serving_spec()
+    configure_slm()
+    endpoint = os.environ['MINIRAG_SLM_URL'].rstrip('/').removesuffix('/v1')
+    headers = {'Authorization': 'Bearer ' + os.environ['MINIRAG_SLM_KEY']}
+    observed = {}
+    for field, route in (('version', '/version'), ('models', '/v1/models')):
+        for attempt in range(4):
+            try:
+                response = httpx.get(endpoint + route, headers=headers, timeout=60)
+                response.raise_for_status()
+                observed[field] = response.json()
+                break
+            except httpx.TimeoutException:
+                if attempt == 3:
+                    raise RuntimeError(f'Phi serving {field} check timed out during cold start') from None
+    models = {item['id']: item for item in observed['models'].get('data', [])}
+    if not {'minirag-slm', spec['model']} <= models.keys():
+        raise RuntimeError('The SLM endpoint does not serve both registered Phi model names')
+    if observed['version'].get('version') != spec['vllm_version']:
+        raise RuntimeError('The SLM endpoint changed vLLM version')
+    revision = models[spec['model']].get('model_revision')
+    if revision is not None and revision != spec['model_revision']:
+        raise RuntimeError('The SLM endpoint changed Phi model revision')
+    return {'at': now(), 'model': spec['model'], 'served_models': sorted(models),
+            'vllm_version': observed['version']['version'], 'registered_model_revision': spec['model_revision'],
+            'observed_model_revision': revision}
+
+
+def require_phi_response(record):
+    if record.get('ok') and record.get('response_model') != p.MODEL:
+        raise RuntimeError(f'SLM response did not identify the registered Phi model: {record.get("response_model")!r}')
+
+
+def traced(directory, action):
+    """Keep a request journal for the frozen runner and reject non-Phi replies."""
+    import llm_trace
+
+    llm_trace.install()
+    with (Path(directory) / 'requests.jsonl').open('a', encoding='utf-8', newline='\n') as handle:
+        def sink(record):
+            record.pop('response_text', None)
+            _phased.append_jsonl(handle, record | {'at': now()})
+            require_phi_response(record)
+
+        with llm_trace.trace(sink):
+            return asyncio.run(action())
+
+
+def verify_index(index, *, pilot=False):
+    from reproduce.index_health import health
+
+    manifest = read(index / 'index_manifest.json')
+    kind, count = ('pilot', 30) if pilot else ('full', 609)
+    if (manifest.get('status') != 'completed' or manifest.get('subset') != kind
+            or manifest.get('counts', {}).get('docs') != count
+            or manifest.get('docs_jsonl_sha256') != DOCS_SHA):
+        raise RuntimeError(f'Expected a completed {count}-article Phi {kind} index')
+    settings = {'chunk_token_size': 1200, 'chunk_overlap_token_size': 100,
+                'tiktoken_model_name': 'gpt-4o-mini', 'entity_extract_max_gleaning': 1,
+                'model': 'minirag-slm', 'embedmodel': 'local', 'max_tokens': '4096'}
+    if pilot:
+        settings.update(pilot_seed=13, pilot_size=30)
+    if any(manifest['settings'].get(key) != value for key, value in settings.items()):
+        raise RuntimeError('Index settings differ from the registered settings')
+    verified = manifest.get('verification')
+    files = manifest.get('file_sha256')
+    if not verified or not all(value is True for value in verified.values()) or not files:
+        raise RuntimeError('Index verification is incomplete')
+    checks = {name: sha(index / name) == digest for name, digest in files.items()}
+    if not all(checks.values()):
+        raise RuntimeError(f'Index files changed: {[name for name, ok in checks.items() if not ok]}')
+    coverage = health(index)
+    if not coverage['chunks'] or coverage['zero_entity_chunks'] / coverage['chunks'] > .05:
+        raise RuntimeError('Index gate I failed: more than 5% of chunks have zero entities')
+    return checks, coverage
+
+
+def prepare_st():
+    from reproduce.mhr_f.pool import check_embedding
+    from reproduce.mhr_st.common import write
+
+    source = source_checks()
+    checks, coverage = verify_index(p.INDEX)
+    check_embedding()
+    from .c0 import require_completed
+    for split, seed in (('dev', 101), *(('test', seed) for seed in SEEDS)):
+        require_completed(split, seed)
+    receipt = {'experiment': 'MultiHop-RAG Phi C0 + source-time only', 'date': '2026-11-18',
+               'source_commit': SOURCE_COMMIT, 'source_checks': source, 'slide_temporal_commit': '1297b2e',
+               'slide_temporal_sha256': sha(p.SHARED_SOURCE / 'temporal_slide.py'),
+               'index': str(p.INDEX), 'index_manifest_sha256': sha(p.INDEX / 'index_manifest.json'),
+               'index_checks': checks, 'index_health': coverage, 'model': p.MODEL,
+               'serving_config_sha256': sha(p.SERVING), 'question_sha256': QUESTION_HASHES,
+               'seeds': list(SEEDS), 'judge_model': JUDGE, 'judge_passes': 3,
+               'budget_tokens': 4000, 'top_k': 60, 'max_answer_tokens': 1024,
+               'st': {'metadata': 'published_at -> every chunk of its document',
+                      'anchors': 'unchanged slide day/month parser', 'per_anchor_limit': 3,
+                      'expand': True, 'entity_h': True, 'fallback': 'native C0 when no anchor'},
+               'controls': 'Phi C0 index, keyword caches, embedding, graph scoring, Entities, prompt and A1 are frozen.',
+               'c0_answers': 'Use same-seed Phi C0 answers and share verdicts for identical ST answers.',
+               'dev': 400, 'test': 2156,
+               'statistics': 'Paired exact McNemar per generation seed. Report ACC, ERR, Neither and no majority.'}
+    # JSON loads the health buckets as lists. Compare the persisted representation.
+    receipt = json.loads(json.dumps(receipt, ensure_ascii=False))
+    dest = p.ST / 'protocol.json'
+    if dest.exists():
+        if read(dest) != receipt:
+            raise RuntimeError('Phi ST protocol or its inputs changed')
+    else:
+        write(dest, receipt)
+    print(json.dumps({'prepared': True, 'source_files_verified': len(source),
+                      'index_files_verified': len(checks), 'run': str(p.ST)}), flush=True)
+
+
+def preflight_st():
+    import httpx
+    from reproduce.mhr_st.common import write
+
+    result = {'at': now(), 'judge_model': JUDGE, 'slm': check_serving(), 'gemini': []}
+    keys = [value for name, value in sorted(os.environ.items())
+            if name.startswith('GEMINI_API_KEY_') and name != 'GEMINI_API_KEY_ONLY' and value]
+    for slot, key in enumerate(keys, 1):
+        try:
+            response = httpx.get('https://generativelanguage.googleapis.com/v1beta/models/' + JUDGE,
+                                 headers={'x-goog-api-key': key}, timeout=15)
+            record = {'key_slot': slot, 'status': response.status_code}
+            if response.status_code == 200:
+                value = response.json()
+                record['model'] = {field: value.get(field) for field in ('name', 'version', 'displayName')}
+            result['gemini'].append(record)
+            if response.status_code == 200:
+                break
+        except httpx.HTTPError as exc:
+            result['gemini'].append({'key_slot': slot, 'error': type(exc).__name__})
+    write(p.ST / 'preflight.json', result)
+    print(json.dumps(result, indent=2), flush=True)
+    return 0 if any(row.get('status') == 200 for row in result['gemini']) else 2
diff --git a/reproduce/mhr_phi/test_profile.py b/reproduce/mhr_phi/test_profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd66e2b992b4cc01bfff6fbc20c1ead043d516e8
--- /dev/null
+++ b/reproduce/mhr_phi/test_profile.py
@@ -0,0 +1,166 @@
+"""Offline profile checks. Run with python -B -m reproduce.mhr_phi.test_profile."""
+
+import ast
+import importlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+from unittest.mock import patch
+
+from . import launch, profile as p, runtime
+
+
+def ladder_modules():
+    """Scan all package files, including modules used only in child processes."""
+    for package in p.PACKAGES:
+        for path in sorted((p.ROOT / package.replace('.', '/')).rglob('*.py')):
+            relative = path.relative_to(p.ROOT).with_suffix('')
+            parts = relative.parts[:-1] if relative.name == '__init__' else relative.parts
+            yield '.'.join(parts), path
+
+
+class ProfileTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        p.apply(offline=True)
+        launch.install_subprocess_rewrite()
+        cls.modules = {name: importlib.import_module(name) for name, _ in ladder_modules()}
+
+    def test_every_global_and_imported_alias(self):
+        allowed = {p.SHARED_SOURCE, p.EMBEDDING_RECEIPT, p.SHARED_INPUTS / 'dev.csv',
+                   p.SHARED_INPUTS / 'test.csv'}
+        forbidden = (*p.QWEN_PATHS, 'qwen-full609', 'serving_qwen',
+                     'minirag/runs/multihop_rag/dev400', 'Qwen2.5-3B')
+        for name, module in self.modules.items():
+            for key, value in vars(module).items():
+                if isinstance(value, (str, Path)):
+                    normalized = str(value).replace('\\', '/').lower()
+                    if any(marker.lower() in normalized for marker in forbidden):
+                        self.assertIn(Path(value), allowed, (name, key, value))
+
+        definitions = {
+            'reproduce.mhr_st.common': {'OUT': p.ST, 'INDEX': p.INDEX, 'ARCHIVE': p.ARCHIVE},
+            'reproduce.mhr_f.pool': {'OUT': p.F, 'DEV_C0_SRC': p.DEV_C0 / 'context.jsonl'},
+            'reproduce.mhr_f.run': {'OUT': p.F, 'MODEL': p.F / 'model_F.json'},
+            'reproduce.mhr_ce.offline': {'OUT': p.CE},
+            'reproduce.mhr_ce.scores': {'OUT': p.CE},
+            'reproduce.mhr_ce.run': {'OUT': p.CE, 'MODEL': p.CE / 'model_CE.json'},
+            'reproduce.mhr_set.offline': {'OUT': p.SET},
+            'reproduce.mhr_set.study': {'MODEL': p.CE / 'model_CE.json',
+                                        'SCORES': p.CE / 'dev_offline/scores_CEF.jsonl',
+                                        'DEV_POOLS': p.F / 'dev/s101/pools.jsonl'},
+            'reproduce.mhr_set.run': {'OUT': p.SET, 'PARAMS': p.SET / 'set_params.json'},
+        }
+        for name, expected in definitions.items():
+            for key, value in expected.items():
+                self.assertEqual(getattr(self.modules[name], key), value, (name, key))
+
+        copies = []
+        for name, path in ladder_modules():
+            module = self.modules[name]
+            tree = ast.parse(path.read_bytes(), filename=str(path))
+            for node in tree.body:
+                if not isinstance(node, ast.ImportFrom):
+                    continue
+                origin = node.module or ''
+                if node.level:
+                    origin = importlib.util.resolve_name('.' * node.level + origin, module.__package__)
+                for binding in node.names:
+                    expected = definitions.get(origin, {}).get(binding.name)
+                    if expected is not None:
+                        key = binding.asname or binding.name
+                        self.assertEqual(getattr(module, key), expected, (name, key, origin))
+                        copies.append(f'{name}.{key}')
+        self.assertTrue(copies, 'AST import scan found no artifact aliases')
+        print(f'Profile import scan: {len(self.modules)} modules, {len(copies)} artifact aliases', flush=True)
+
+    def test_runtime_paths_and_question_hashes(self):
+        pipeline = self.modules['reproduce.mhr_st.pipeline']
+        self.assertEqual(pipeline.reference('dev', 101), p.DEV_C0)
+        self.assertEqual(pipeline.reference('test', 202), p.ARCHIVE / 'qa/s202/C0_s202')
+        self.assertEqual(self.modules['reproduce.mhr_st.finish'].QUESTIONS, p.ST / 'inputs/test.csv')
+        self.assertEqual(runtime.setup(), p.SHARED_SOURCE.resolve())
+        self.assertEqual(runtime.phased_runner().INDEX, p.INDEX)
+        self.assertEqual(runtime.phased_runner().snapshot.__defaults__, (p.INDEX,))
+        self.assertTrue(all(runtime.source_checks().values()))
+        for split, expected in runtime.QUESTION_HASHES.items():
+            self.assertEqual(runtime.sha(p.SHARED_INPUTS / f'{split}.csv'), expected)
+            self.assertEqual(runtime.sha(p.ST / 'inputs' / f'{split}.csv'), expected)
+
+    def test_subprocess_run_and_popen_propagate_profile(self):
+        prefix = [sys.executable, '-B', '-u', '-m']
+        for name in ('reproduce.mhr_st.run', 'reproduce.mhr_st.judge', 'reproduce.mhr_f.pool',
+                     'reproduce.mhr_ce.run', 'reproduce.mhr_ce.judge_entry',
+                     'reproduce.mhr_set.run', 'reproduce.mhr_set.judge_entry', launch.C0_MODULE):
+            original = prefix + [name, '--help']
+            self.assertEqual(launch.rewrite_command(original), prefix + [launch.MODULE, name, '--help'])
+        other = prefix + ['json.tool']
+        self.assertIs(launch.rewrite_command(other), other)
+        script = [sys.executable, 'script.py', '-m', 'reproduce.mhr_st.run']
+        self.assertIs(launch.rewrite_command(script), script)
+        already = prefix + [launch.MODULE, 'reproduce.mhr_st.run']
+        self.assertIs(launch.rewrite_command(already), already)
+
+        command = prefix + ['reproduce.mhr_st.run', 'status']
+        options = {'cwd': p.ROOT, 'env': os.environ | {'MINIRAG_DOTENV': str(p.ROOT / '.env.phi-profile-test')},
+                   'text': True}
+        result = subprocess.run(command, check=True, capture_output=True, **options)
+        self.assertEqual(Path(json.loads(result.stdout)['run']), p.ST)
+        with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **options) as child:
+            stdout, stderr = child.communicate()
+            self.assertEqual(child.returncode, 0, stderr)
+        self.assertEqual(Path(json.loads(stdout)['run']), p.ST)
+
+    def test_guard_blocks_qwen_writes_dotenv_and_sockets(self):
+        for root in p.QWEN_ROOTS:
+            target = root / '_phi_guard_must_never_exist'
+            with self.assertRaisesRegex(PermissionError, 'Qwen artifact is read-only'):
+                target.open('xb')
+            with self.assertRaisesRegex(PermissionError, 'Qwen artifact is read-only'):
+                sys.audit('os.rename', str(p.OUT / 'placeholder'), str(target), -1, -1)
+            with self.assertRaisesRegex(PermissionError, 'Qwen artifact is read-only'):
+                sys.audit('os.remove', str(target), -1)
+        for name in ('.env', '.ENV.local'):
+            with self.assertRaisesRegex(PermissionError, 'Only the Phi launcher'):
+                (p.ROOT / name).open('rb')
+        with self.assertRaisesRegex(PermissionError, 'Network is disabled'):
+            sys.audit('socket.getaddrinfo', 'offline-test.invalid', 443, 0, 0, 0)
+        sys.audit('open', str(p.OUT / 'permitted_append.jsonl'), 'a', os.O_WRONLY | os.O_APPEND)
+
+    def test_mock_serving_and_response_gates(self):
+        from types import SimpleNamespace
+
+        spec = runtime.serving_spec()
+        verified = [{'id': 'minirag-slm'}, {'id': p.MODEL, 'model_revision': spec['model_revision']}]
+
+        def reply(data):
+            return SimpleNamespace(raise_for_status=lambda: None, json=lambda: data)
+
+        env = {'MINIRAG_SLM_URL': 'https://offline-test.invalid/v1', 'MINIRAG_SLM_KEY': 'test',
+               'MINIRAG_KW_CACHE': ''}
+        with patch.dict(os.environ, env):
+            with patch('httpx.get', side_effect=[reply({'version': '0.11.0'}), reply({'data': verified})]) as get:
+                self.assertEqual(runtime.check_serving()['observed_model_revision'], spec['model_revision'])
+                self.assertEqual([call.args[0].rsplit('.invalid', 1)[1] for call in get.call_args_list],
+                                 ['/version', '/v1/models'])
+            for version, models, error in (
+                ('0.11.0', [{'id': 'minirag-slm'}], 'model names'),
+                ('0.12.0', verified, 'vLLM version'),
+                ('0.11.0', [verified[0], verified[1] | {'model_revision': 'wrong'}], 'model revision'),
+            ):
+                with patch('httpx.get', side_effect=[reply({'version': version}), reply({'data': models})]):
+                    with self.assertRaisesRegex(RuntimeError, error):
+                        runtime.check_serving()
+        runtime.require_phi_response({'ok': True, 'response_model': p.MODEL})
+        runtime.require_phi_response({'ok': False})
+        for model in ('Qwen/Qwen2.5-3B-Instruct', 'minirag-slm', None):
+            with self.assertRaisesRegex(RuntimeError, 'did not identify'):
+                runtime.require_phi_response({'ok': True, 'response_model': model})
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
