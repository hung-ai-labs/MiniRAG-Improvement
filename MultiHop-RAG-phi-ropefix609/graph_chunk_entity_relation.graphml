  <data key="d0">"PERSON"</data>
  <data key="d1">"Mazariegos is an individual advocating for improvements in liver transplant allocation policies and raising awareness about organ donation."</data>
  <data key="d2">chunk-1e13a4fbbdc0014a4f475e69c3423866</data>
</node>
