  <data key="d2">chunk-05f30bb173fe6db60e7dcd8827ab3372</data>
</node>
<node id="&quot;INTERNATIONAL FEDERATION OF THE PHONOGRAPHIC INDUSTRY (IFPI)&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"IFPI is a non-profit organization representing the recording industry worldwide, including matters related to copyright and distribution of sound recordings."</data>
  <data key="d2">chunk-05f30bb173fe6db60e7dcd8827ab3372</data>
</node>
<node id="&quot;BERLIN MUSIC RIGHTS ASSOCIATION&quot;">
  <data key="d0">"ORGANIZATION"</data>
