  <data key="d2">chunk-e490838f50c95a4858bf1b6ee00e208f</data>
</node>
<node id="&quot;ASIA-PACIFIC ECONOMIC COOPERATION MEETING&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Asia-Pacific Economic Cooperation meeting is an event occurring alongside the U.S.-China summit, highlighting its importance in international relations."&lt;SEP&gt;"Asia-Pacific Economic Cooperation meeting is an event that is occurring alongside the U.S.-China summit, highlighting its importance in international relations."</data>
  <data key="d2">chunk-e490838f50c95a4858bf1b6ee00e208f</data>
</node>
