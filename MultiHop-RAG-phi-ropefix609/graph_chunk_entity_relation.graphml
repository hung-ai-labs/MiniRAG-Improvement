  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Fifth Third Bank is the financial institution behind the Fifth Third 1.67% Card, providing the credit card service and associated benefits."&lt;SEP&gt;"Fifth Third Bank is the financial institution issuing the Fifth Third 1.67% Cash/Back Card."</data>
  <data key="d2">chunk-c6323f1c3b6acede9c7c36b10402c7dc&lt;SEP&gt;chunk-72a7b9a25301b7267bc40d465b842356</data>
</node>
<node id="&quot;CREDIT CARD REWARDS&quot;">
  <data key="d0">"SERVICE"</data>
