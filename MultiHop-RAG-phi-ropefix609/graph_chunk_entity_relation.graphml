  <data key="d2">chunk-13177b3a00c03568bfa4c1f94b997728</data>
</node>
<node id="&quot;MONEY LINE&quot;">
  <data key="d0">"BETTING TERM"</data>
  <data key="d1">"Money Line offers odds on individual teams with pricing adjusted for favorites and underdogs, allowing bettors to wager based on expected victory margins."</data>
  <data key="d2">chunk-13177b3a00c03568bfa4c1f94b997728</data>
</node>
<node id="&quot;OUTRIGHT BET&quot;">
  <data key="d0">"BETTING TERM"</data>
