  <data key="d1">"The shared habit of frequently applying lipstick between Diane Bazella and Sherri Nordlie Geerts provides a light-hearted and humorous detail that illustrates their personal connection and similarities."</data>
  <data key="d2">chunk-744e9c97a6d45202a9b9e56ec2e46f00</data>
</node>
<node id="&quot;18-YEAR-OLD MOTHERHOOD&quot;">
  <data key="d0">"CONCEPT"</data>
