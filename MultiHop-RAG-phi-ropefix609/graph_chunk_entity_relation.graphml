  <data key="d2">chunk-d6591af99296b06f81f0c8ad61a88b03</data>
</node>
<node id="&quot;PLAYER SALARIES AND TRANSFERS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Player Salaries and Transfers relate to sports betting in the sense that they can affect team performance and, consequently, betting outcomes for games and matchups."</data>
  <data key="d2">chunk-d6591af99296b06f81f0c8ad61a88b03</data>
</node>
