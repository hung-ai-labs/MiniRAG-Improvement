</node>
<node id="&quot;MUSIC COPYRIGHT COLLECTIVES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Music Copyright Collectives are organizations that collect royalties on behalf of multiple rights holders, playing a critical role in music licensing and distribution.</data>
  <data key="d2">chunk-05f30bb173fe6db60e7dcd8827ab3372</data>
</node>
<node id="&quot;MUSIC RIGHTS MANAGEMENT COMPANIES&quot;">
