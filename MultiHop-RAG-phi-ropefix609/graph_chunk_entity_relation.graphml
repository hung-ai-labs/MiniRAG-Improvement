  <data key="d2">chunk-05f30bb173fe6db60e7dcd8827ab3372</data>
</node>
<node id="&quot;MUSIC PUBLISHING AGENTS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Music Publishing Agents represent songwriters and publishers, facilitating the negotiation and sale of music rights.</data>
