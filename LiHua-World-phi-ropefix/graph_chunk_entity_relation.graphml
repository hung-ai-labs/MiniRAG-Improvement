  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Narrative Depth describes the complexity and layered storytelling found in modern video games, which enhances player engagement and immersion."</data>
  <data key="d2">chunk-953924359c48fae687acc00ad69285db</data>
</node>
<node id="&quot;DEEP CHARACTER EXPLORATION&quot;">
  <data key="d0">"CONCEPT"</data>
